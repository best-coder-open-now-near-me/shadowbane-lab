{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadowbane-lab.invalid/schemas/verification-receipt-v1.schema.json",
  "title": "Shadowbane Lab verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "manifest_id", "verified_at_utc", "verifier_id", "verifier_version", "store_id", "status", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verified_at_utc": {"type": "string"},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_version": {"type": "string", "minLength": 1},
    "store_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "present", "size_matches", "digest_matches", "issue", "passed"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "present": {"type": "boolean"},
          "size_matches": {"type": "boolean"},
          "digest_matches": {"type": "boolean"},
          "issue": {"type": ["string", "null"]},
          "passed": {"type": "boolean"}
        }
      }
    }
  }
}
