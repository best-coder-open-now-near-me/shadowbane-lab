{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadowbane-lab.invalid/schemas/artifact-descriptor-v1.schema.json",
  "title": "Shadowbane Lab artifact descriptor v1",
  "$ref": "#/$defs/artifact",
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "sha256", "size_bytes", "media_type", "artifact_kind", "logical_name", "producer_id", "producer_version", "captured_at_utc", "redaction", "parents", "metadata"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact_kind": {"enum": ["client_tree_manifest", "pe_inspection", "build_diff", "runtime_snapshot", "character_snapshot", "service_snapshot", "environment_snapshot", "native_event_stream", "semantic_trace", "input_audit", "client_log", "screenshot", "video", "packet_capture", "packet_summary", "process_metrics", "etw_trace", "process_dump", "simulation_result", "differential_report", "source_snapshot", "asset_extract", "coverage_report", "impact_report", "other_reviewed"]},
        "logical_name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "producer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "producer_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "captured_at_utc": {"type": ["string", "null"]},
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "policy_id", "source_artifact_id"],
          "properties": {
            "state": {"enum": ["not_required", "pending", "redacted"]},
            "policy_id": {"type": ["string", "null"]},
            "source_artifact_id": {"oneOf": [{"$ref": "#/$defs/artifactId"}, {"type": "null"}]}
          }
        },
        "parents": {"type": "array", "items": {"$ref": "#/$defs/artifactId"}, "uniqueItems": true},
        "metadata": {"type": "object"}
      }
    }
  }
}
