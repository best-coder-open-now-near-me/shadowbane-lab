{
  "schema_version": 1,
  "profile_id": "wonderbane-pve-1920x955-captured-hotkeys-and-hotbar-live-locked",
  "live_input_enabled": false,
  "target": {
    "executable_names": [
      "sb.exe"
    ],
    "title_pattern": "^Shadowbane$",
    "reference_width": 1920,
    "reference_height": 955,
    "dpi_scale": 1.0,
    "size_tolerance_px": 0,
    "dpi_tolerance": 0.01
  },
  "actions": [
    {
      "action_key": "client.pve.target_next_mobile",
      "activation": {
        "type": "key",
        "key": ";"
      },
      "target_order": "none",
      "post_activation_delay_ms": 250
    },
    {
      "action_key": "shadowbane.assassin.shadow_touch",
      "activation": {
        "type": "key",
        "key": "f2"
      },
      "target_order": "none",
      "post_activation_delay_ms": 250
    },
    {
      "action_key": "shadowbane.basic_attack",
      "activation": {
        "type": "hotkey",
        "keys": [
          "ctrl",
          "a"
        ]
      },
      "target_order": "none",
      "post_activation_delay_ms": 250
    }
  ],
  "movement": {
    "action_key": "shadowbane.move",
    "center": {
      "x": 0.5,
      "y": 0.5
    },
    "horizontal_radius": 0.25,
    "vertical_radius": 0.2,
    "button": "left"
  },
  "camera": {
    "anchor": {
      "x": 0.5,
      "y": 0.5
    },
    "maximum_horizontal_delta": 0.2,
    "maximum_vertical_delta": 0.15,
    "duration_ms": 1000,
    "button": "left"
  }
}
