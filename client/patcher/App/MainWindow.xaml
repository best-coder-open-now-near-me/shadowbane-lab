<Window x:Class="Shadowbane.Patcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Shadowbane — Private Client" Width="980" Height="650" MinWidth="840" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="#111720" Foreground="#EDF0F4" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A1AFC0"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Background" Value="#263343"/><Setter Property="Foreground" Value="#EDF0F4"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
      Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F2CE91"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#111720"/><Setter Property="Foreground" Value="#EDF0F4"/>
   <Setter Property="BorderBrush" Value="#354457"/><Setter Property="Padding" Value="10"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid Background="#111720">
  <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#18222E" Padding="27,34">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="S H A D O W B A N E" FontSize="16" FontWeight="SemiBold" Foreground="#E8C183"/>
     <TextBlock Text="PRIVATE CLIENT" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
     <Border Background="#304239" CornerRadius="4" Padding="9,6" Margin="0,32,0,0" HorizontalAlignment="Left">
      <TextBlock Text="FRIENDS CHANNEL" FontSize="10" Foreground="#B8D4BA"/>
     </Border>
     <TextBlock Text="Our server.&#10;Our updates." FontSize="25" FontWeight="Light" Margin="0,26,0,0" LineHeight="34"/>
     <TextBlock Text="One place to update, repair, and get back into the world." TextWrapping="Wrap"
       Foreground="{StaticResource Muted}" FontSize="13" LineHeight="21" Margin="0,18,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock Text="PRIVATE TAILSCALE FEED" FontSize="10" Foreground="#E8C183"/>
     <TextBlock Text="Keep Tailscale connected for updates and server access." TextWrapping="Wrap"
       Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,9,0,20"/>
     <TextBlock Text="Patcher 1.0.0" FontSize="11" Foreground="#75879B"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,30,32,27">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel>
    <TextBlock Text="CLIENT UPDATES" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    <TextBlock x:Name="VersionLabel" Text="Checking release" FontSize="13" Foreground="#E8C183" HorizontalAlignment="Right"/>
   </DockPanel>
   <StackPanel Grid.Row="1" Margin="0,20,0,20">
    <TextBlock Text="Ready for the next adventure." FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="Subtitle" Text="Your client improvements, in one place." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#19232F" CornerRadius="8" Padding="22,20" Margin="0,0,0,22">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="WHAT'S NEW" FontSize="11" Foreground="#E8C183" Margin="0,0,0,15"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="Notes" Text="Connect to the private update feed to see the latest release notes."
       TextWrapping="Wrap" Foreground="#D8E0E8" FontSize="14" LineHeight="25"/>
     </ScrollViewer>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3">
    <TextBlock Text="GAME FOLDER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="RootBox" IsReadOnly="True" AutomationProperties.Name="Game folder"/>
     <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="BrowseClicked"/>
    </Grid>
    <TextBlock x:Name="Status" Text="Choose the folder containing sb.exe." TextWrapping="Wrap"
      Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,8" MinHeight="30"/>
    <ProgressBar x:Name="Progress" Height="3" Background="#263343" Foreground="#E8C183" BorderThickness="0" Maximum="100"/>
   </StackPanel>
   <Grid Grid.Row="4" Margin="0,18,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="CheckButton" Content="Check" Click="CheckClicked"/>
    <Button x:Name="UpdateButton" Grid.Column="1" Content="Update / Repair" Margin="9,0,0,0" Click="UpdateClicked" IsEnabled="False"/>
    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" HorizontalAlignment="Left" Margin="9,0,0,0" Click="CancelClicked" Visibility="Collapsed"/>
    <Button x:Name="PlayButton" Grid.Column="3" Content="PLAY" Width="135" Background="#D9B47B" Foreground="#18202B"
      FontWeight="Bold" Click="PlayClicked" IsDefault="True" IsEnabled="False"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
